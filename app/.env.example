# Локально (Homebrew Postgres, без Docker):
DATABASE_URL="postgresql://nowayrm@localhost:5432/ayn_marketplace?schema=public"
# Docker Compose (production / VPS):
#   ./docker/up.sh
# DATABASE_URL підставляється автоматично в docker-compose.yml
POSTGRES_USER=ayn
POSTGRES_PASSWORD=ayn_dev_password
POSTGRES_DB=ayn_marketplace
NEXT_PUBLIC_BASE_URL=https://your-domain.com
NEXT_PUBLIC_WEBAPP_URL=https://your-domain.com
