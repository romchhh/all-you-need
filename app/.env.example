NEXT_PUBLIC_BOT_USERNAME=TradeGroundBot
WEBAPP_URL=https://your-domain.com
TELEGRAM_BOT_TOKEN=
MONOBANK_TOKEN=
MONOBANK_API_URL=https://api.monobank.ua
MODERATION_GROUP_ID=
TRADE_CHANNEL_ID=
TRADE_GERMANY_CHANNEL_ID=

# Веб-адмінка /admin/login (Docker також читає bot/.env — можна дублювати там)
ADMIN_USERNAME=admin
