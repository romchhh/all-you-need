# TradeGround Bot — приклад .env (скопіюй у .env)
# Автоматично:  ./docker/prepare-env.sh  або  ./docker/up.sh
# ══════════════════════════════════════════════

# ── База даних ────────────────────────────────
# Docker Compose підставляє URL автоматично. Локально без Docker — SQLite:
# DATABASE_URL=file:../../database/ayn_marketplace.db
DATABASE_URL=postgresql://ayn:ayn_dev_password@postgres:5432/ayn_marketplace?schema=public

# ── Бот ───────────────────────────────────────
TOKEN=
BOT_USERNAME=TradeGroundBot
ADMINISTRATORS=[123456789]
WEBAPP_URL=https://example.com
BOT_API_KEY=
SUPPORT_MANAGER=https://t.me/support

# Веб-адмінка (/admin/login) — окремо від ADMINISTRATORS (Telegram ID у боті)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# ── Канали / групи ────────────────────────────
MODERATION_GROUP_ID=
TRADE_CHANNEL_ID=
TRADE_GERMANY_CHANNEL_ID=

# ── Парсер: 3 групи модерації ─────────────────
# 1) Послуги → Hamburg-канал + маркетплейс
PARSER_MOD_SERVICES_HAMBURG_ID=-1003796207726
# 2) Послуги → Germany-канал + маркетплейс
PARSER_MOD_SERVICES_GERMANY_ID=-1003714727651
# 3) Товари → лише маркетплейс
PARSER_MOD_GOODS_ID=-1003901841142
# Канали публікації послуг (після ✅)
TRADE_SERVICES_CHANNEL_HAMBURG_ID=
TRADE_SERVICES_CHANNEL_GERMANY_ID=

# ── Платежі ───────────────────────────────────
MONOBANK_TOKEN=

# ── OpenAI (секрет — лише в .env) ─────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Парсер (інтервал, AI flags, dedup, quiet 08:00–20:00 Berlin) —
# лише bot/parser/config/tuning.py (не .env)

# ══════════════════════════════════════════════
# Pyrogram-акаунти: керуються в боті
# Адмін-панель → «Парсер акаунти» (не через .env)
# Сесії: bot/parser/sessions/
# ══════════════════════════════════════════════
