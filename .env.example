# Скопіюй у `.env` у корені репозиторію (поруч із docker-compose.yml).
# Автоматично:  ./docker/prepare-env.sh  або  ./docker/up.sh
# Можна також:  ln -sf bot/.env .env

APP_PORT=3000

# PostgreSQL (docker-compose за замовчуванням)
POSTGRES_USER=ayn
POSTGRES_PASSWORD=ayn_dev_password
POSTGRES_DB=ayn_marketplace
DATABASE_URL=postgresql://ayn:ayn_dev_password@postgres:5432/ayn_marketplace?schema=public

# Обов'язкові (або візьми з bot/.env)
TOKEN=
BOT_USERNAME=TradeGroundBot
ADMINISTRATORS=[123456789]
WEBAPP_URL=https://your-domain.com
SUPPORT_MANAGER=https://t.me/support

NEXT_PUBLIC_BOT_URL=https://t.me/TradeGroundBot
NEXT_PUBLIC_BOT_USERNAME=TradeGroundBot
NEXT_PUBLIC_MARKETPLACE_TELEGRAM_ONLY=

MONOBANK_TOKEN=
MONOBANK_API_URL=https://api.monobank.ua

MODERATION_GROUP_ID=
TRADE_CHANNEL_ID=
TRADE_GERMANY_CHANNEL_ID=
